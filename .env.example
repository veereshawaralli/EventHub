# Django Secret Key (generate a random one or use any string for local dev)
SECRET_KEY=django-insecure-local-dev-key

# Database
# Local dev: leave empty to use SQLite (default).
# Production: use your Supabase "Session pooler" connection string:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Debug Mode
DEBUG=True

# Payment (Razorpay) - Get these from your Razorpay dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (Media storage) - Optional for local
CLOUDINARY_URL=

# Email (Optional for local - uses console by default)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
